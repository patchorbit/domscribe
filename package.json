{
  "name": "domscribe",
  "version": "0.6.1",
  "author": {
    "name": "Patch Orbit",
    "email": "kaushik@patchorbit.com",
    "url": "https://patchorbit.com"
  },
  "description": "Domscribe is a pixel-to-code development tool that maps running UI elements to their exact source locations, capturing runtime context (props, state, DOM) for handoff to coding agents via MCP.",
  "license": "MIT",
  "scripts": {
    "sync-dist": "nx run-many -t sync-dist",
    "build:all": "nx run-many -t=lint,test,build --exclude domscribe-test-fixtures --output-style=stream",
    "build:affected": "nx affected -t lint,test,build --exclude domscribe-test-fixtures --output-style=stream",
    "release:version:local": "nx release version prerelease --preid dev --git-commit=false --git-tag=false --stage-changes=false",
    "release:publish:local": "nx run-many -t sync-dist && nx release publish --registry=http://localhost:4873",
    "release:local": "pnpm run build:all && pnpm run release:version:local && pnpm run release:publish:local",
    "release:local:affected": "pnpm run build:affected && pnpm run release:version:local && pnpm run release:publish:local",
    "release:post-version": "nx run sync-versions && git add -A && git commit -m \"chore: release v$(node -p \"require('./package.json').version\")\" && git tag \"v$(node -p \"require('./package.json').version\")\"",
    "release:patch": "nx release version patch && pnpm run release:post-version",
    "release:minor": "nx release version minor && pnpm run release:post-version",
    "release:major": "nx release version major && pnpm run release:post-version",
    "registry:publish": "pnpm run build:all && pnpm run registry:publish:only",
    "registry:publish:only": "pnpm run release:version:local && pnpm run release:publish:local",
    "registry:install": "npx tsx packages/domscribe-test-fixtures/scripts/install-fixture.ts",
    "pipeline:full": "pnpm run registry:publish && pnpm run registry:install && nx run-many -t integration,e2e -p domscribe-test-fixtures",
    "pipeline:integration": "nx integration domscribe-test-fixtures",
    "pipeline:e2e": "pnpm run registry:publish && pnpm run registry:install && nx e2e domscribe-test-fixtures"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/devkit": "22.7.12",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/vite": "22.7.12",
    "@nx/vitest": "22.7.12",
    "@nx/web": "22.7.12",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.19",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "2.6.1",
    "jsdom": "~28.1.0",
    "jsonc-eslint-parser": "^3.3.0",
    "nx": "22.7.12",
    "prettier": "^3.9.10",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "verdaccio": "^6.11.1",
    "vite": "^7.3.7",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "4.1.12"
  },
  "workspaces": [
    "packages/*",
    "!packages/domscribe-test-fixtures/fixtures/**"
  ],
  "keywords": [
    "domscribe",
    "patchorbit",
    "pixel-to-code",
    "ui-to-code",
    "dom-annotation",
    "source-mapping",
    "source-location",
    "runtime-context",
    "element-inspector",
    "component-inspector",
    "dom-inspector",
    "developer-tools",
    "devtools",
    "mcp",
    "model-context-protocol",
    "annotation",
    "ai-coding-assistant",
    "ai-coding-agent",
    "coding-agent",
    "coding-assistant",
    "react",
    "vue",
    "nextjs",
    "nuxt",
    "vite-plugin",
    "webpack-plugin",
    "bundler-plugin",
    "ast-transform"
  ],
  "repository": "github:patchorbit/domscribe",
  "bugs": {
    "url": "https://github.com/patchorbit/domscribe/issues"
  },
  "homepage": "https://github.com/patchorbit/domscribe#readme",
  "nx": {
    "includedScripts": [],
    "targets": {
      "sync-versions": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/sync-versions.mjs"
        }
      },
      "coverage-badge": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^test"
        ],
        "options": {
          "command": "node scripts/aggregate-coverage.mjs"
        }
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage",
          "clear": false
        }
      }
    }
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "nx>axios": "^1.20.0",
      "nx>follow-redirects": "^1.16.1",
      "nx>brace-expansion": "^5.0.12",
      "nx>smol-toml": "^1.9.1",
      "postcss-selector-parser@<7.1.6": "^7.1.7"
    }
  }
}
