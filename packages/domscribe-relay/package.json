{
  "name": "@domscribe/relay",
  "version": "0.6.1",
  "description": "Local relay server and MCP adapter for Domscribe",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./program": "./src/program/index.ts"
  },
  "distExports": {
    "./client": "./client/index.js",
    "./program": "./program/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "distBin": {
    "domscribe": "./cli/bin/main.js",
    "domscribe-mcp": "./cli/bin/mcp.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@domscribe/core": "workspace:*",
    "@domscribe/manifest": "workspace:*",
    "@domscribe/verify": "workspace:*",
    "@fastify/cors": "^10.1.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.3",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^6.1.0",
    "nanoid": "^5.1.16",
    "openapi-types": "^12.1.3",
    "semver": "^7.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patchorbit/domscribe.git",
    "directory": "packages/domscribe-relay"
  }
}
